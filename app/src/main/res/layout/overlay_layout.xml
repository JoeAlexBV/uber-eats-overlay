<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#DD000000"
    android:padding="8dp">

    <TextView
        android:id="@+id/overlay_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pay: $X.XX\nNet: $X.XX\nRate: $X.XX/hr"
        android:textColor="#00FF00"
        android:textSize="16sp"
        android:fontFamily="monospace" />

    <!-- New TextView for add-on specific information -->
    <TextView
        android:id="@+id/overlay_addon_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Overall Rate: $X.XX/hr (+/-$X.XX)"
        android:textColor="#FFFF00" <!-- Yellow for add-on info -->
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:visibility="gone" /> <!-- Initially hidden -->

</LinearLayout>